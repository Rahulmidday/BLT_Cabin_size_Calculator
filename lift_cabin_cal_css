* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #f8fafc;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: 2rem;
    color: #333;
}

.calculator-container {
    display: flex;
    flex-direction: column;
    background: #fff;
    width: 100%;
    max-width: 1000px;
    border-radius: 12px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    border: 1px solid #e2e8f0;
}

@media (min-width: 768px) {
    .calculator-container {
        flex-direction: row;
    }
}

/* Input Panel (Dark Theme) */
.input-panel {
    flex: 1;
    background-color: #1e293b;
    color: #fff;
    padding: 2rem;
}

.title {
    font-size: 1.5rem;
    color: #60a5fa;
    margin-bottom: 0.5rem;
}

.subtitle {
    color: #94a3b8;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
}

.form-group {
    margin-bottom: 1.25rem;
}

.form-group label {
    display: block;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    color: #e2e8f0;
}

.form-group input, 
.form-group select {
    width: 100%;
    padding: 0.75rem;
    background-color: #334155;
    border: 1px solid #475569;
    border-radius: 6px;
    color: #fff;
    font-size: 1rem;
}

.form-group input:focus, 
.form-group select:focus {
    outline: none;
    border-color: #60a5fa;
}

.btn-calculate {
    width: 100%;
    background-color: #2563eb;
    color: #fff;
    padding: 0.875rem;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    margin-top: 1rem;
    transition: background-color 0.2s;
}

.btn-calculate:hover {
    background-color: #3b82f6;
}

/* Results Panel (Light Theme) */
.results-panel {
    flex: 1;
    background-color: #fff;
    padding: 2rem;
    position: relative;
    display: flex;
    flex-direction: column;
}

.results-title {
    font-size: 1.25rem;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    color: #0f172a;
}

/* Result Cards */
.result-card {
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    border: 1px solid transparent;
}

.result-card h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
}

.card-blue {
    background-color: #eff6ff;
    border-color: #dbeafe;
}
.card-blue h3 { color: #1e40af; }
.card-blue .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
}

.card-gray {
    background-color: #f8fafc;
    border-color: #f1f5f9;
}
.card-gray h3 { color: #64748b; }

.card-green {
    background-color: #f0fdf4;
    border-color: #dcfce3;
}
.card-green h3 { color: #166534; }
.pax-val {
    font-size: 1.5rem;
    font-weight: 700;
    color: #14532d;
}

.val {
    font-weight: 600;
    color: #0f172a;
}

.text-warning {
    color: #d97706;
    font-size: 0.875rem;
    font-weight: 500;
    margin-top: 0.5rem;
}

/* Door Sizes */
.doors-section h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 0.75rem;
}

.door-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.door-list li {
    background-color: #e2e8f0;
    color: #334155;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
}

/* States */
.hidden {
    display: none !important;
}
.mt-1 { margin-top: 0.5rem; }

.error-msg {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    padding: 1rem;
    border-radius: 8px;
}

.empty-state {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #fff;
    padding: 2rem;
    text-align: center;
    color: #94a3b8;
}
